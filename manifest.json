{
  "manifest_version": 2,
  "core_api_major": 5,
  "package_version": "1.0.8",
  "id": "gp_star_wave",
  "name": "GodotPartyDefault · 星潮",
  "kind": "minigame",
  "supported_systems": ["windows"],
  "entry": "game.tscn",
  "player_counts": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "tags": [
    "original"
  ],
  "dependencies": {
    "godot_party_default_protocol": "1.0.7"
  },
  "adapters": [
    {
      "id": "standard",
      "protocol": {
        "id": "godot_party_default_protocol",
        "api_major": 1,
        "min_api_minor": 0
      },
      "entry": "adapter.gd"
    }
  ],
  "config_schema": "settings.gd",
  "player_count_rules": [
    {
      "when": {
        "mode": "团队赛"
      },
      "counts": [
        2,
        4,
        6,
        8
      ]
    }
  ],
  "introduction": "连续三关、十种敌人、三名关底 Boss。个人赛 1–8 人按积分排名；团队赛 2/4/6/8 人分队挑战，通关队优先，未通关队按生存时长排名。",
  "localization": {
    "supported_locales": [
      "zh_Hans"
    ],
    "fallback_locale": "zh_Hans",
    "translations": {
      "zh_Hans": "i18n/zh_Hans.po"
    }
  }
}
